---
import { Image } from "astro:assets";
import profilePic from "../assets/profile-pic.jpeg";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import BlogPost from "../components/BlogPost.astro";
import WorkCard from "../components/WorkCard.astro";
import nycRestaurantsScreenshot from "../assets/nyc-restaurant-app.png";
import staticDodo from "../assets/static-dodo-npmjs.png";
import bikeShareMap from "../assets/bike-share-app.png";
const allPosts = await getCollection("posts");
const me = "Francesco Menghi";
const description = `The personal website of ${me}`;
---

<BaseLayout pageTitle={me} description={description}>
  <main>
    <div class="introduction">
      <div class="profile-wrap">
        <span class="profile-squircle profile-squircle--one" aria-hidden="true"
        ></span>
        <span class="profile-squircle profile-squircle--two" aria-hidden="true"
        ></span>
        <Image
          class="smooth-shadow"
          height={200}
          densities={[3]}
          id="profile-picture"
          src={profilePic}
          alt={`Portrait of ${me}`}
          loading="eager"
        />
      </div>
      <h1>{me}</h1>
      <p class="subtitle">Software Developer · Toronto, Canada</p>

      <p class="description">
        Full-stack software developer with 4+ years of experience building
        object-oriented applications and modern JavaScript/React web
        applications. Experienced in owning CI/CD pipelines and collaborating
        cross-functionally, with a track record of quickly picking up new tools
        and frameworks. I work in TypeScript, React and Node through open source
        and side projects.
      </p>
    </div>

    <h2>Experience</h2>
    <article class="job">
      <div class="job-header">
        <h3>Product Programmer</h3>
        <p class="job-meta">
          <b
            ><a
              href="https://www.teknion.com"
              target="_blank"
              rel="noopener noreferrer">Teknion</a
            ></b
          > · <time datetime="2022-09">Sept 2022</time> - Present
        </p>
      </div>
      <p>
        I write the logic that governs how Teknion products can be configured
        and assembled, so that every layout a designer builds is valid by
        construction. It's used by internal design and sales teams, and by
        external dealers placing Teknion furniture in their own floor plans.
      </p>
      <ul>
        <li>
          I helped build the first Teknion product line extension to work across
          multiple catalogues, targeting a shared parent class and handling each
          catalogue's edge cases separately. Later product lines reused the
          pattern.
        </li>
        <li>
          I built and currently maintain a GitLab CI/CD pipeline (PowerShell,
          with a runner on an internal server) that runs a build on every merge
          request for a team of 10. It replaced builds run locally before
          merging, where inconsistent CET versions allowed breakage tied to a
          specific version to reach the main branch.
        </li>
      </ul>
      <p>
        The work is done in Configura CM, a statically typed, garbage collected
        OOP language, in a large production codebase with code review, git
        workflows and a regular release cycle.
      </p>
    </article>

    <div class="section-header">
      <h2>Selected Work</h2>
      <a class="view-all" href="/projects">View all projects →</a>
    </div>
    <ul class="work-grid">
      <WorkCard
        title="React App"
        body="Restaurant finder for NYC, built with React, MongoDB Atlas, and Leaflet maps."
        image={nycRestaurantsScreenshot}
        imageAlt="React restaurant app screenshot"
        href="https://restaurants-app.menghi.me"
        tags={["React", "MongoDB", "Leaflet"]}
      />
      <WorkCard
        title="Static Site Generator"
        body="CLI tool that converts Markdown/text files into HTML pages, published to npm."
        image={staticDodo}
        imageAlt="Static Dodo Npmjs webpage screenshot"
        href="https://www.npmjs.com/package/static-dodo"
        tags={["Node.js", "CLI"]}
      />
      <WorkCard
        title="Bike Share Map"
        body="Live Bike Share Toronto data on a map, with geolocation to find nearby bikes."
        image={bikeShareMap}
        imageAlt="Bike Share Map screenshot"
        href="https://bikeshare.menghi.me"
        tags={["JavaScript", "Geolocation API"]}
      />
    </ul>

    <div class="section-header">
      <h2>Latest Posts</h2>
      <a class="view-all" href="/blog">View all posts →</a>
    </div>
    <ul class="latest-posts">
      {
        allPosts
          .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
          .slice(0, 3)
          .map((post) => (
            <BlogPost
              featured
              hideDate
              url={`/blog/${post.id}`}
              title={post.data.title}
              description={post.data.description}
            />
          ))
      }
    </ul>
  </main>
</BaseLayout>

<style>
  h1 {
    font-size: 2.4rem;
    margin-bottom: 0;
    text-align: center;
    font-weight: bold;
    background: -webkit-linear-gradient(var(--text2), var(--text1));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .latest-posts {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    width: 100%;
  }

  .introduction {
    display: flex;
    gap: 0.5rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin: 1.5rem 0;
  }

  .subtitle {
    margin: 0;
    opacity: 80%;
    font-size: 1.4rem;
    font-style: italic;
    font-weight: 500;
    text-align: center;
  }

  .description {
    opacity: 90%;
  }

  .profile-wrap {
    position: relative;
    display: inline-flex;
  }

  #profile-picture {
    position: relative;
    z-index: 1;
    border-radius: 20%;
  }

  .profile-squircle {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 0;
    width: 12.5rem;
    height: 12.5rem;
    border-radius: 20%;
    pointer-events: none;
    box-shadow:
      0.35rem 0.5rem 0.5rem -0.25rem hsl(var(--surface-shadow) / 0.35),
      0.15rem 0.2rem 1.25rem hsl(var(--surface-shadow) / 0.25);
  }

  .profile-squircle--one {
    background: linear-gradient(
      135deg,
      hsl(var(--hue) 20% 64%),
      hsl(var(--hue) 20% 38%)
    );
    transform: translate(-46%, -50%) rotate(4deg);
  }

  .profile-squircle--two {
    background: linear-gradient(
      135deg,
      hsl(var(--hue) 80% 74%),
      hsl(var(--hue) 80% 46%)
    );
    transform: translate(-48%, -50%) rotate(2deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .profile-squircle {
      transition: none;
    }
  }

  .hero-actions {
    margin: 0.5rem 0 1.5rem 0;
  }

  .job {
    padding: 2rem;
    border-radius: 1rem;
    background-color: var(--surface3);
    margin-top: 1rem;
  }

  .job-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .job h3 {
    margin: 0;
  }

  .job-meta {
    margin: 0;
    color: var(--text2);
    font-style: italic;
  }

  .section-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .section-header h2 {
    margin-bottom: 0;
  }

  .view-all {
    text-decoration: none;
    font-size: var(--step--1);
  }

  .view-all:hover {
    text-decoration: underline;
    text-decoration-color: var(--link);
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 1rem 0 2rem 0;
  }

  @media screen and (max-width: 900px) {
    .work-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 700px) {
    .latest-posts {
      flex-direction: column;
    }

    .work-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

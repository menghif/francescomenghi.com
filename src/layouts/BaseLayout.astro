---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import interNormalUrl from "@fontsource-variable/inter/files/inter-latin-standard-normal.woff2?url";
import interItalicUrl from "@fontsource-variable/inter/files/inter-latin-standard-italic.woff2?url";

interface Props {
  pageTitle: string;
  description?: string;
}

const { pageTitle, description } = Astro.props;
const me = "Francesco Menghi";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link
      rel="preload"
      href={interNormalUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={interItalicUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="fediverse:creator" content="@francesco@social.lol" />
    <title>
      {Astro.url.pathname === "/" ? pageTitle : `${pageTitle} | ${me}`}
    </title>
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title=`${me}'s Blog`
      href={`${Astro.site}rss.xml`}
    />
  </head>
  <body>
    <a class="skip-nav" href="#main">Skip navigation</a>
    <div id="body-content">
      <Header />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

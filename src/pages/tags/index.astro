---
import { getPosts, uniqueTags } from "../../lib/posts";
import BaseLayout from "../../layouts/BaseLayout.astro";
const pageTitle = "Tags";
const tags = uniqueTags(await getPosts());
---

<BaseLayout pageTitle={pageTitle}>
  <h1>{pageTitle}</h1>
  <div class="tags">
    {
      tags.map((tag) => (
        <a class="tag" href={`/tags/${tag.slug}`}>
          {tag.label}
        </a>
      ))
    }
  </div>
</BaseLayout>

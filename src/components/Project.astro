---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  type: string;
  body: string;
  image: ImageMetadata;
  imageAlt: string;
  appLink?: string;
  codeLink: string;
  tags?: string[];
}

const {
  title,
  type,
  body,
  image,
  imageAlt,
  appLink,
  codeLink,
  tags = [],
} = Astro.props;
---

<section class="project-item smooth-shadow scroll-reveal">
  <div class="screenshot">
    <a href={appLink ? appLink : codeLink}
      ><Image
        src={image}
        width={320}
        densities={[2]}
        alt={imageAlt}
        loading="eager"
      /></a
    >
  </div>
  <div class="project-info">
    <h2>{title}</h2>
    <p>{body}</p>
    <div class="tags">
      {tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>
    <div class="links">
      {
        /* prettier-ignore */
        appLink && <a class="link" href={appLink}>View {type}</a>
      }
      <a class="link" href={codeLink}>Source Code</a>
    </div>
  </div>
</section>

<style>
  p {
    font-size: 1.1rem;
  }

  .project-item {
    display: flex;
    gap: 2rem;
    margin: 2rem 0;
    padding: 2rem;
    border-radius: 1rem;
    background-color: var(--surface3);
  }

  .screenshot {
    flex: 2;
    border-radius: 0.5rem;
    overflow: hidden;
    transition: transform 400ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .screenshot:hover {
    cursor: pointer;
    transform: scale(1.04);
  }

  .screenshot a {
    display: block;
  }

  .project-info {
    flex: 3;
  }

  img {
    display: block;
    width: 20rem;
    border-radius: 0.5rem;
    object-fit: cover;
  }

  h2 {
    margin-top: 0;
  }

  .tags {
    margin: 0.75rem 0 1.25rem 0;
  }

  .tags .tag {
    padding: 0.25rem 0.65rem;
    font-size: var(--step--2);
  }

  .links {
    display: flex;
    gap: 1.25rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .screenshot {
      transition: none;
    }
  }

  @media screen and (max-width: 600px) {
    .project-item {
      display: block;
    }

    img {
      width: 100%;
    }
  }
</style>

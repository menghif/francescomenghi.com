---
import BaseLayout from "./BaseLayout.astro";
import type { Post } from "../lib/posts";
import Calendar from "../components/icons/CalendarDots.astro";
import TextAlignLeft from "../components/icons/TextAlignLeft.astro";
import User from "../components/icons/UserIcon.astro";

interface Props {
  frontmatter: Post;
}

const { frontmatter } = Astro.props;
---

<BaseLayout pageTitle={frontmatter.title} description={frontmatter.description}>
  <div>
    <h1>
      {frontmatter.title}
    </h1>
    <div class="post-info">
      <div class="info-line">
        <Calendar />
        <p>{frontmatter.pubDate.toString().slice(4, 15)}</p>
      </div>
      <div class="info-line">
        <TextAlignLeft />
        <p>
          <em>{frontmatter.description}</em>
        </p>
      </div>
      <div class="info-line">
        <User />
        <p>
          Written by: <a class="author" href="/about">{frontmatter.author}</a>
        </p>
      </div>
    </div>
    {
      frontmatter.cover && (
        <img
          class="image"
          width={1440}
          src={frontmatter.cover.src}
          alt={frontmatter.cover.alt}
          loading="eager"
        />
      )
    }
    <div class="post-content prose-serif">
      <slot />
    </div>

    <div class="tags">
      {
        frontmatter.tags.map((tag) => (
          <a class="tag" href={`/tags/${tag.slug}`}>
            {tag.label}
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  p {
    margin: 0.5rem 0;
  }
  .info-line {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .post-info {
    margin-bottom: 2rem;
    background-color: var(--surface4);
    border-radius: 0.6rem;
    padding: 0.25rem 1rem;
  }

  .author {
    color: var(--text2);
  }

  .image {
    margin: 0;
    border-radius: 0.6rem;
  }

  .tags {
    margin-top: 2.5rem;
  }
</style>

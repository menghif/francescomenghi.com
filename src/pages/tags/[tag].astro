---
import BlogPost from "../../components/BlogPost.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TagIcon from "../../components/icons/TagIcon.astro";
import { getPosts, uniqueTags } from "../../lib/posts";

export async function getStaticPaths() {
  const tags = uniqueTags(await getPosts());
  return tags.map((tag) => ({ params: { tag: tag.slug } }));
}

const { tag: tagSlug } = Astro.params;
const allPosts = await getPosts();
const tag = uniqueTags(allPosts).find((t) => t.slug === tagSlug);

if (!tag) {
  return Astro.rewrite("/404");
}

const posts = allPosts.filter((post) =>
  post.tags.some((t) => t.slug === tag.slug),
);
---

<BaseLayout pageTitle={tag.label}>
  <div>
    <h1>
      Tag: <a class="tag" href="/tags">{tag.label}</a>
    </h1>
    <ul>
      {
        posts.map((post) => (
          <BlogPost
            url={`/blog/${post.slug}`}
            title={post.title}
            pubDate={post.pubDate}
          />
        ))
      }
    </ul>
    <a class="tags-link" href="/tags"><TagIcon />Tags</a>
  </div>
</BaseLayout>

<style>
  h1 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  ul {
    padding-left: 0;
  }

  .tag {
    margin-top: 1rem;

    font-weight: 400;
  }
</style>

---
interface Props {
  url: string;
  title: string;
  pubDate?: Date;
  featured?: boolean;
  hideDate?: boolean;
  description?: string;
}

const { url, title, pubDate, featured, hideDate, description } = Astro.props;
---

<li
  class:list={[
    { box: featured },
    { "smooth-shadow": featured },
    { "scroll-reveal": featured },
  ]}
>
  <p>
    <a href={url} class="post">{title}</a>
    {
      !hideDate && pubDate && (
        <>
          {" "}
          · <span class="date">{pubDate.toString().slice(4, 15)}</span>
        </>
      )
    }
  </p>
  {description && <p class="description">{description}</p>}
</li>

<style>
  li {
    flex: 1;
    list-style-type: none;
  }

  p {
    margin: 1rem 0;
  }

  .post {
    color: var(--text1);
    text-decoration: none;
    font-size: 1.25rem;
  }

  .post:hover {
    text-decoration: underline;
    text-decoration-color: var(--link);
  }

  .date {
    font-size: 85%;
    font-style: italic;
    color: var(--text2);
  }

  .description {
    margin-top: 0;
    color: var(--text2);
    font-size: 0.95rem;
  }

  .box {
    padding-inline: 1rem;
  }
</style>
